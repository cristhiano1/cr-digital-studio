# ─────────────────────────────────────────────────────────────────────────────
# CR Digital Systems — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env to Git.
# Set real values in the Netlify dashboard under Site → Environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server-side only — Netlify Function) ────────────────────────────
# Required for the contact form to save messages.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Lead notification via Resend (server-side only — Netlify Function) ────────
# Optional. When all three are set, a notification email is sent after each
# successful Supabase insert. If any are absent, the notification is skipped
# and the form submission still succeeds.
# RESEND_FROM_EMAIL must be a verified sender address in your Resend account.
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=

# ── Cloudflare Turnstile (anti-spam) ──────────────────────────────────────────
# VITE_TURNSTILE_SITE_KEY  — public site key, exposed to the browser (VITE_ prefix).
# TURNSTILE_SECRET_KEY     — server-only secret used by the Netlify Function to verify tokens.
#
# Both values MUST be configured together in production.
# The backend only enforces Turnstile when TURNSTILE_SECRET_KEY is set.
# Setting TURNSTILE_SECRET_KEY without VITE_TURNSTILE_SITE_KEY will cause
# all form submissions to fail (no frontend widget → no token → backend rejects).
#
# Leave both empty for local development (form works without Turnstile).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CORS origin (server-side only — Netlify Function) ────────────────────────
# When set, the contact function restricts CORS to this exact origin.
# Use the public production URL (e.g. https://example.com).
# Leave empty for local development (allows all origins).
SITE_ORIGIN=

# ── Supabase public keys (optional — for future client-side queries) ──────────
# These are safe to expose in the browser (VITE_ prefix required by Vite).
# Not currently used by any frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

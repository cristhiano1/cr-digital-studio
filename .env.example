# ─────────────────────────────────────────────────────────────────────────────
# CR Digital Studio — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env to Git.
# Set real values in the Netlify dashboard under Site → Environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server-side only — Netlify Function) ────────────────────────────
# Required for the contact form to save messages.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (optional) ──────────────────────────────────────────
# When TURNSTILE_SECRET_KEY is set, the function enforces anti-spam verification.
# If not set, anti-spam verification is skipped (useful during development).
TURNSTILE_SECRET_KEY=

# ── Supabase public keys (optional frontend use) ─────────────────────────────
# Only needed if you add client-side Supabase queries in the future.
# These are safe to expose in the browser (VITE_ prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Removed ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY    — email notifications removed; messages are stored in Supabase only
# CONTACT_EMAIL     — not required without email delivery

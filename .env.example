# ─────────────────────────────────────────────
# CR Digital Studio — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Supabase (public keys — safe in frontend) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase service role (server-side only — Netlify Function) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (server-side only — Netlify Function) ──
RESEND_API_KEY=

# ── Contact notification email ──
CONTACT_EMAIL=

# ── Cloudflare Turnstile ──
# Get from: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=       # Server-side (Netlify Function)
VITE_TURNSTILE_SITE_KEY=    # Client-side (shown in browser)
